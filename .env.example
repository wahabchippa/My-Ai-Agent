# Copy this file to .env and fill in your own values.
# .env is gitignored and NEVER committed.

# PostgreSQL database URL (local dev)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Server-side AI key — powers all chat (APNA AI backend).
# Get a free key from https://openrouter.ai/keys (one key -> hundreds of models).
# Set this in your host's Environment Variables (e.g. Vercel) for production.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
