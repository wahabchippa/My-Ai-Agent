# ═══════════════════════════════════════════════════
# NEXORA — Environment Variables
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# .env is gitignored and NEVER committed.

# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── AI API Keys (server-side only) ──
GROQ_API_KEY=
OPENROUTER_API_KEY=
BAZAARLINK_API_KEY=
AIRFORCE_API_KEY=

# ═══════════════════════════════════════════════════
# GOOGLE OAUTH
# ═══════════════════════════════════════════════════
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Click "Create Credentials" → "OAuth Client ID"
# 3. Application type: Web application
# 4. Authorized JavaScript origins:
#      http://localhost:3000           (local dev)
#      https://your-domain.com        (production)
# 5. Authorized redirect URIs:
#      http://localhost:3000/api/auth/oauth/google/callback   (local dev)
#      https://your-domain.com/api/auth/oauth/google/callback (production)
# 6. Copy Client ID and Client Secret below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ═══════════════════════════════════════════════════
# GITHUB OAUTH
# ═══════════════════════════════════════════════════
# 1. Go to: https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Application name: Nexora
# 4. Homepage URL:
#      http://localhost:3000           (local dev)
#      https://your-domain.com        (production)
# 5. Authorization callback URL:
#      http://localhost:3000/api/auth/oauth/github/callback   (local dev)
#      https://your-domain.com/api/auth/oauth/github/callback (production)
# 6. Copy Client ID and generate + copy Client Secret below:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── App URL (optional — auto-detected on Vercel) ──
# Only needed if you're not on Vercel and not on localhost:3000
# APP_URL=https://your-domain.com
