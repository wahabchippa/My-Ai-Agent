# ═══════════════════════════════════════════════════
# NEXORA — Environment Variables
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# .env is gitignored and NEVER committed.

# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ═══════════════════════════════════════════════════
# AI API KEYS (server-side only)
#
# ⚠ KAM SE KAM EK ZAROORI HAI.
# Bina key ke app keyless public endpoints use karti hai, jo asal me
# 2023-2024 ke purane models serve karte hain — jawab ghalat aayenge.
#
# Verify: node scripts/verify-models.mjs
# Guide:  SETUP-FREE-AI.md
# ═══════════════════════════════════════════════════

# ── ⭐ SABSE ZAROORI — Gemini ──
# Free: 1,500 req/day · card nahi chahiye · web search grounding built-in
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── ⭐ SABSE TEZ — Groq ──
# Free: 14,400 req/day · ~2,600 tok/s
# https://console.groq.com/keys
GROQ_API_KEY=

# ── Cerebras (optional) — free 1M tokens/day, context 8K limited ──
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# ── OpenRouter (optional) — 16 free (:free) models, ek key ──
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Legacy / optional providers ──
DEEPSEEK_API_KEY=
BAZAARLINK_API_KEY=
AIRFORCE_API_KEY=

# ═══════════════════════════════════════════════════
# GOOGLE OAUTH
# ═══════════════════════════════════════════════════
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Click "Create Credentials" → "OAuth Client ID"
# 3. Application type: Web application
# 4. Authorized JavaScript origins:
#      http://localhost:3000           (local dev)
#      https://your-domain.com        (production)
# 5. Authorized redirect URIs:
#      http://localhost:3000/api/auth/oauth/google/callback   (local dev)
#      https://your-domain.com/api/auth/oauth/google/callback (production)
# 6. Copy Client ID and Client Secret below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ═══════════════════════════════════════════════════
# GITHUB OAUTH
# ═══════════════════════════════════════════════════
# 1. Go to: https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Application name: Nexora
# 4. Homepage URL:
#      http://localhost:3000           (local dev)
#      https://your-domain.com        (production)
# 5. Authorization callback URL:
#      http://localhost:3000/api/auth/oauth/github/callback   (local dev)
#      https://your-domain.com/api/auth/oauth/github/callback (production)
# 6. Copy Client ID and generate + copy Client Secret below:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── ModelsLab (Studio image-edit + video) — optional ──
# Vercel me ek dafa daalo. Studio me key paste ki zaroorat nahi.
# https://modelslab.com
MODELSLAB_API_KEY=

# ── App URL (optional — auto-detected on Vercel) ──
# Only needed if you're not on Vercel and not on localhost:3000
# APP_URL=https://your-domain.com
