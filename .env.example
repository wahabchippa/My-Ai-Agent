# Copy this file to .env and fill in your own values.
# .env is gitignored and NEVER committed.

# PostgreSQL database URL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# AI API Keys (server-side only)
GROQ_API_KEY=
OPENROUTER_API_KEY=
BAZAARLINK_API_KEY=
AIRFORCE_API_KEY=

# OAuth — Google
# Create credentials at https://console.cloud.google.com/apis/credentials
# Set authorized redirect URI to: {YOUR_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

# OAuth — GitHub
# Create OAuth App at https://github.com/settings/developers
# Set authorization callback URL to: {YOUR_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/oauth/github/callback

# App URL (used for OAuth redirects in production)
# APP_URL=https://your-domain.com
